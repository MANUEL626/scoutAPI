# ─────────────────────────────────────────────────────────────
# ScoutAPI — Exemple de configuration (.env.example)
# Copiez ce fichier en .env et adaptez les valeurs.
# ─────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_NAME=ScoutAPI
APP_VERSION=1.0.0
APP_SECRET_KEY=change-me-in-production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
API_KEY_PREFIX=sk_scout_
API_KEY_DEFAULT_NAME=n8n
# En dev vous pouvez mettre "*" ; en prod, listez les domaines autorisés séparés par des virgules
ALLOWED_ORIGINS=["*"]

# ─── Base de données ─────────────────────────────────────────
# Option Docker Compose (recommandé avec docker-compose up)
DATABASE_URL=postgresql+asyncpg://scoutapi:scoutapi_password@postgres:5432/scoutapi_db
# Option locale (si Postgres tourne en local) — décommentez si besoin
# DATABASE_URL=postgresql+asyncpg://scoutapi:scoutapi_password@localhost:5432/scoutapi_db

# Variables utilisées par le service Postgres du docker-compose
POSTGRES_USER=scoutapi
POSTGRES_PASSWORD=scoutapi_password
POSTGRES_DB=scoutapi_db

# ─── Redis / Cache ───────────────────────────────────────────
# Option Docker Compose
REDIS_URL=redis://redis:6379/0
# Option locale — décommentez si besoin
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400
ARQ_QUEUE_NAME=scoutapi:jobs
ARQ_JOB_TIMEOUT_SECONDS=600

# ─── OpenRouter / IA ─────────────────────────────────────────
# Clé API OpenRouter (ne PAS committer)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=ScoutAPI
AI_MODEL_PARSING=openai/gpt-oss-120b:free
AI_MODEL_QUALIFICATION=deepseek/deepseek-chat-v3.1:free
AI_MODEL_ENRICHMENT=google/gemini-2.0-flash-exp:free
AI_MODEL_DETECTION=qwen/qwen3-32b:free
AI_MODEL_FALLBACK=nvidia/nemotron-nano-9b-v2:free

# Tavily Search (optionnel, recommande pour une discovery plus stable que le scraping Google direct)
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_RAW_CONTENT=false
TAVILY_COUNTRY=france

# ─── Proxies (optionnel) ─────────────────────────────────────
# Liste de proxies séparés par des virgules (ex: http://user:pass@host:port, socks5://host:port)
PROXY_LIST=
PROXY_HEALTH_CHECK_INTERVAL=300
PROXY_MAX_FAILURES=3

# ─── Scraping — Délais & Concurrence ─────────────────────────
DELAY_GOOGLE_MIN=3.0
DELAY_GOOGLE_MAX=8.0
DELAY_LINKEDIN_MIN=5.0
DELAY_LINKEDIN_MAX=15.0
DELAY_DIRECTORY_MIN=1.0
DELAY_DIRECTORY_MAX=4.0
MAX_RETRIES=3
MAX_CONCURRENT_SCRAPERS=3
SCRAPER_TIMEOUT=30
SCRAPER_DISCOVERY_TIMEOUT_SECONDS=240
SCRAPER_ITEM_TIMEOUT_SECONDS=12
SCRAPER_MAX_QUERY_VARIANTS=5
SCRAPER_MAX_RESULTS_PER_QUERY=6
SCRAPER_DISCOVERY_PROVIDER=auto
URL_CACHE_TTL_SECONDS=21600
SITE_CRAWLER_MAX_CONTACT_PAGES=5
SITE_CRAWLER_ENABLE_SITEMAP=true
MERGE_DUPLICATE_LEADS=true
PAGES_JAUNES_DEDICATED_EXTRACTOR=true
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36

# ─── LinkedIn (optionnel; utiliser un compte dédié) ──────────
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_MAX_PROFILE_VIEWS_PER_DAY=80
LINKEDIN_MAX_SEARCHES_PER_DAY=40

# ─── Rate Limiting API ───────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
FREE_MAX_ACTIVE_JOBS_PER_USER=3
FREE_MAX_JOBS_PER_DAY=20
FREE_MAX_RESULTS_PER_JOB=50
DOMAIN_RATE_LIMIT_DEFAULT_SECONDS=1.5
DOMAIN_RATE_LIMIT_PAGESJAUNES_SECONDS=4.0
DOMAIN_RATE_LIMIT_LINKEDIN_SECONDS=15.0
DOMAIN_RATE_LIMIT_GOOGLE_SECONDS=8.0

# ─── Captcha Providers (optionnel) ───────────────────────────
TWOCAPTCHA_API_KEY=
ANTICAPTCHA_API_KEY=

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/scoutapi.log

# Render:
# - Ne gardez pas @postgres ni @redis sur Render: utilisez les URLs internes
#   fournies par Render, par exemple DATABASE_URL=<Internal Database URL>
#   et REDIS_URL=<Internal Redis URL>.
# - Les formats postgres:// et postgresql:// sont acceptes et convertis
#   automatiquement en postgresql+asyncpg://.
# - Le conteneur ecoute automatiquement le port fourni par PORT.

# ─── Notes ───────────────────────────────────────────────────
# - En prod: APP_ENV=production, LOG_LEVEL=INFO (ou WARN), ALLOWED_ORIGINS configuré finement.
# - Ne commitez jamais OPENROUTER_API_KEY et APP_SECRET_KEY.
# - Avec Docker Compose, gardez les hôtes "postgres" et "redis" comme ci-dessus.
